<%# Partial : bannière de consentement cookies (carte Google Maps) -%>
<div id="cookie-banner" class="cookie-banner" role="region" aria-label="Consentement aux cookies" hidden>
  <p class="cookie-banner__text">
    Ce site utilise une carte Google Maps pour situer la zone d'intervention. Son
    affichage dépose des cookies de la part de Google. Vous pouvez accepter ou
    refuser ce dépôt.
  </p>
  <div class="cookie-banner__actions">
    <button type="button" id="cookie-refuse" class="btn-outline">Refuser</button>
    <button type="button" id="cookie-accept" class="btn-pink">Accepter</button>
  </div>
</div>